# Copy this file to .env and fill in. Never commit .env.

# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=your-meta-model-api-key-here

# Models (defaults shown)
AGENT_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# Independent checker: Muse Spark Open on Baseten (hackathon model name is fixed).
# Leave all three blank to use Muse Spark on Meta's API for the checker instead.
CHECKER_BASE_URL=https://inference.baseten.co/v1
CHECKER_API_KEY=your-baseten-key-here
CHECKER_MODEL=meta-models/muse-spark-open-1026

# Equipment profile file in faultlens/knowledge/
EQUIPMENT_PROFILE=split_ac

# 1 = offline mode, no API calls, canned answers (for UI work only)
FAULTLENS_MOCK=0
